import java.util.*;


// ======================================================
// 1. SYMBOL
// ======================================================

enum Symbol {
    X,
    O,
    EMPTY
}


// ======================================================
// 2. POSITION
// ======================================================

class Position {

    int row;
    int col;

    public Position(int row, int col) {
        this.row = row;
        this.col = col;
    }
}


// ======================================================
// 3. STRATEGY PATTERN
// ======================================================

// Common strategy interface
interface PlayerStrategy {

    Position makeMove(Board board);
}


// ------------------------------------------------------
// Human Move Strategy
// ------------------------------------------------------

class HumanMoveStrategy implements PlayerStrategy {

    private Scanner scanner = new Scanner(System.in);

    @Override
    public Position makeMove(Board board) {

        while (true) {

            System.out.print("Enter row: ");
            int row = scanner.nextInt();

            System.out.print("Enter column: ");
            int col = scanner.nextInt();

            Position position =
                    new Position(row, col);

            if (board.isValidMove(position)) {
                return position;
            }

            System.out.println(
                    "Invalid move. Try again."
            );
        }
    }
}


// ------------------------------------------------------
// AI Move Strategy
// ------------------------------------------------------

class AIMoveStrategy implements PlayerStrategy {

    @Override
    public Position makeMove(Board board) {

        // Simple AI:
        // Find first empty position

        for (int i = 0; i < board.getSize(); i++) {

            for (int j = 0; j < board.getSize(); j++) {

                Position position =
                        new Position(i, j);

                if (board.isValidMove(position)) {
                    return position;
                }
            }
        }

        return null;
    }
}


// ======================================================
// 4. PLAYER INTERFACE
// ======================================================

interface Player {

    String getName();

    Symbol getSymbol();

    Position makeMove(Board board);
}


// ======================================================
// 5. HUMAN PLAYER
// ======================================================

class HumanPlayer implements Player {

    private String name;
    private Symbol symbol;

    // Strategy is passed from outside
    private PlayerStrategy strategy;


    public HumanPlayer(
            String name,
            Symbol symbol,
            PlayerStrategy strategy) {

        this.name = name;
        this.symbol = symbol;
        this.strategy = strategy;
    }


    @Override
    public String getName() {
        return name;
    }


    @Override
    public Symbol getSymbol() {
        return symbol;
    }


    @Override
    public Position makeMove(Board board) {

        return strategy.makeMove(board);
    }
}


// ======================================================
// 6. AI PLAYER
// ======================================================

class AIPlayer implements Player {

    private String name;
    private Symbol symbol;

    // Strategy is passed from outside
    private PlayerStrategy strategy;


    public AIPlayer(
            String name,
            Symbol symbol,
            PlayerStrategy strategy) {

        this.name = name;
        this.symbol = symbol;
        this.strategy = strategy;
    }


    @Override
    public String getName() {
        return name;
    }


    @Override
    public Symbol getSymbol() {
        return symbol;
    }


    @Override
    public Position makeMove(Board board) {

        return strategy.makeMove(board);
    }
}


// ======================================================
// 7. FACTORY PATTERN
// ======================================================

class PlayerFactory {


    public static Player createPlayer(
            String type,
            String name,
            Symbol symbol,
            PlayerStrategy strategy) {


        if (type.equalsIgnoreCase("human")) {

            return new HumanPlayer(
                    name,
                    symbol,
                    strategy
            );
        }


        if (type.equalsIgnoreCase("ai")) {

            return new AIPlayer(
                    name,
                    symbol,
                    strategy
            );
        }


        throw new IllegalArgumentException(
                "Invalid player type"
        );
    }
}


// ======================================================
// 8. OBSERVER PATTERN
// ======================================================

interface GameObserver {

    void update(
            Player player,
            Position position
    );
}


// ------------------------------------------------------
// Display Observer
// ------------------------------------------------------

class DisplayObserver implements GameObserver {

    @Override
    public void update(
            Player player,
            Position position) {

        System.out.println(
                player.getName()
                + " placed "
                + player.getSymbol()
                + " at ("
                + position.row
                + ", "
                + position.col
                + ")"
        );
    }
}


// ------------------------------------------------------
// Logger Observer
// ------------------------------------------------------

class GameLogger implements GameObserver {

    @Override
    public void update(
            Player player,
            Position position) {

        System.out.println(
                "[LOG] "
                + player.getName()
                + " made a move."
        );
    }
}


// ======================================================
// 9. STATE PATTERN
// ======================================================

interface GameState {

    void next(
            GameContext context,
            Player player,
            boolean hasWon,
            boolean isDraw
    );

    boolean isGameOver();
}


// ======================================================
// 10. GAME CONTEXT
// ======================================================

class GameContext {

    private GameState currentState;


    public GameContext() {

        currentState =
                new PlayingState();
    }


    public void next(
            Player player,
            boolean hasWon,
            boolean isDraw) {

        currentState.next(
                this,
                player,
                hasWon,
                isDraw
        );
    }


    public void setState(GameState state) {

        currentState = state;
    }


    public GameState getState() {

        return currentState;
    }


    public boolean isGameOver() {

        return currentState.isGameOver();
    }
}


// ======================================================
// 11. PLAYING STATE
// ======================================================

class PlayingState implements GameState {


    @Override
    public void next(
            GameContext context,
            Player player,
            boolean hasWon,
            boolean isDraw) {


        if (hasWon) {

            context.setState(
                    new WonState(player)
            );

        }
        else if (isDraw) {

            context.setState(
                    new DrawState()
            );
        }
    }


    @Override
    public boolean isGameOver() {

        return false;
    }
}


// ======================================================
// 12. WON STATE
// ======================================================

class WonState implements GameState {

    private Player winner;


    public WonState(Player winner) {

        this.winner = winner;
    }


    public Player getWinner() {

        return winner;
    }


    @Override
    public void next(
            GameContext context,
            Player player,
            boolean hasWon,
            boolean isDraw) {

        // Game already finished
    }


    @Override
    public boolean isGameOver() {

        return true;
    }
}


// ======================================================
// 13. DRAW STATE
// ======================================================

class DrawState implements GameState {


    @Override
    public void next(
            GameContext context,
            Player player,
            boolean hasWon,
            boolean isDraw) {

        // Game already finished
    }


    @Override
    public boolean isGameOver() {

        return true;
    }
}


// ======================================================
// 14. BOARD
// ======================================================

class Board {

    private int size;

    private Symbol[][] grid;

    // Observers
    private List<GameObserver> observers =
            new ArrayList<>();


    public Board(int size) {

        this.size = size;

        grid =
                new Symbol[size][size];


        for (int i = 0; i < size; i++) {

            for (int j = 0; j < size; j++) {

                grid[i][j] =
                        Symbol.EMPTY;
            }
        }
    }


    // --------------------------------------------------
    // Add Observer
    // --------------------------------------------------

    public void addObserver(
            GameObserver observer) {

        observers.add(observer);
    }


    // --------------------------------------------------
    // Notify Observers
    // --------------------------------------------------

    private void notifyObservers(
            Player player,
            Position position) {


        for (GameObserver observer : observers) {

            observer.update(
                    player,
                    position
            );
        }
    }


    // --------------------------------------------------
    // Validate Move
    // --------------------------------------------------

    public boolean isValidMove(
            Position position) {


        if (position == null) {
            return false;
        }


        if (position.row < 0 ||
            position.row >= size ||
            position.col < 0 ||
            position.col >= size) {

            return false;
        }


        return grid[position.row][position.col]
                == Symbol.EMPTY;
    }


    // --------------------------------------------------
    // Make Move
    // --------------------------------------------------

    public void makeMove(
            Position position,
            Player player) {


        grid[position.row][position.col] =
                player.getSymbol();


        // Notify all observers
        notifyObservers(
                player,
                position
        );
    }


    // --------------------------------------------------
    // Check Winner
    // --------------------------------------------------

    public boolean hasWinner(
            Symbol symbol) {


        // Check rows

        for (int i = 0; i < size; i++) {

            boolean win = true;


            for (int j = 0; j < size; j++) {

                if (grid[i][j] != symbol) {

                    win = false;
                    break;
                }
            }


            if (win) {
                return true;
            }
        }


        // Check columns

        for (int j = 0; j < size; j++) {

            boolean win = true;


            for (int i = 0; i < size; i++) {

                if (grid[i][j] != symbol) {

                    win = false;
                    break;
                }
            }


            if (win) {
                return true;
            }
        }


        // Check main diagonal

        boolean win = true;


        for (int i = 0; i < size; i++) {

            if (grid[i][i] != symbol) {

                win = false;
                break;
            }
        }


        if (win) {
            return true;
        }


        // Check other diagonal

        win = true;


        for (int i = 0; i < size; i++) {

            if (grid[i][size - 1 - i]
                    != symbol) {

                win = false;
                break;
            }
        }


        return win;
    }


    // --------------------------------------------------
    // Check Draw
    // --------------------------------------------------

    public boolean isFull() {


        for (int i = 0; i < size; i++) {

            for (int j = 0; j < size; j++) {

                if (grid[i][j]
                        == Symbol.EMPTY) {

                    return false;
                }
            }
        }


        return true;
    }


    // --------------------------------------------------
    // Print Board
    // --------------------------------------------------

    public void printBoard() {

        System.out.println();


        for (int i = 0; i < size; i++) {

            for (int j = 0; j < size; j++) {

                System.out.print(
                        grid[i][j] + " "
                );
            }

            System.out.println();
        }


        System.out.println();
    }


    public int getSize() {

        return size;
    }
}


// ======================================================
// 15. TIC TAC TOE GAME
// ======================================================

class TicTacToeGame {

    private Board board;

    private List<Player> players;

    private int currentPlayerIndex;

    private GameContext gameContext;


    public TicTacToeGame(
            Board board,
            List<Player> players) {

        this.board = board;

        this.players = players;

        this.currentPlayerIndex = 0;

        this.gameContext =
                new GameContext();
    }


    // --------------------------------------------------
    // Play Game
    // --------------------------------------------------

    public void play() {


        while (!gameContext.isGameOver()) {


            // Display board

            board.printBoard();


            // Get current player

            Player currentPlayer =
                    players.get(
                            currentPlayerIndex
                    );


            System.out.println(
                    "Turn: "
                    + currentPlayer.getName()
                    + " ("
                    + currentPlayer.getSymbol()
                    + ")"
            );


            // ==========================================
            // STRATEGY PATTERN IS USED HERE
            // ==========================================

            Position position =
                    currentPlayer.makeMove(
                            board
                    );


            // Make move

            board.makeMove(
                    position,
                    currentPlayer
            );


            // Check winner

            boolean hasWon =
                    board.hasWinner(
                            currentPlayer.getSymbol()
                    );


            // Check draw

            boolean isDraw =
                    !hasWon &&
                    board.isFull();


            // ==========================================
            // STATE PATTERN
            // ==========================================

            gameContext.next(
                    currentPlayer,
                    hasWon,
                    isDraw
            );


            // Game over?

            if (gameContext.isGameOver()) {

                announceResult();

                break;
            }


            // Next player

            currentPlayerIndex =
                    (currentPlayerIndex + 1)
                    % players.size();
        }
    }


    // --------------------------------------------------
    // Announce Result
    // --------------------------------------------------

    private void announceResult() {


        board.printBoard();


        GameState state =
                gameContext.getState();


        if (state instanceof WonState) {


            WonState wonState =
                    (WonState) state;


            System.out.println(
                    "Winner: "
                    + wonState
                            .getWinner()
                            .getName()
            );
        }


        else if (state instanceof DrawState) {

            System.out.println(
                    "Game Draw!"
            );
        }
    }
}


// ======================================================
// 16. MAIN
// ======================================================

public class Main {

    public static void main(String[] args) {


        // =================================================
        // STEP 1: CREATE STRATEGIES
        // =================================================

        PlayerStrategy humanStrategy =
                new HumanMoveStrategy();


        PlayerStrategy aiStrategy =
                new AIMoveStrategy();


        // =================================================
        // STEP 2: CREATE PLAYERS USING FACTORY
        // =================================================

        Player player1 =
                PlayerFactory.createPlayer(
                        "human",
                        "Player X",
                        Symbol.X,
                        humanStrategy
                );


        Player player2 =
                PlayerFactory.createPlayer(
                        "ai",
                        "Computer O",
                        Symbol.O,
                        aiStrategy
                );


        // =================================================
        // STEP 3: CREATE BOARD
        // =================================================

        Board board =
                new Board(3);


        // =================================================
        // STEP 4: REGISTER OBSERVERS
        // =================================================

        board.addObserver(
                new DisplayObserver()
        );


        board.addObserver(
                new GameLogger()
        );


        // =================================================
        // STEP 5: CREATE PLAYERS LIST
        // =================================================

        List<Player> players =
                Arrays.asList(
                        player1,
                        player2
                );


        // =================================================
        // STEP 6: CREATE GAME
        // =================================================

        TicTacToeGame game =
                new TicTacToeGame(
                        board,
                        players
                );


        // =================================================
        // STEP 7: START GAME
        // =================================================

        game.play();
    }
}
